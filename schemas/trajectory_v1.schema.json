{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparsecoderlab.local/schemas/trajectory_v1.schema.json",
  "title": "Evidence-grounded tool trajectory v1",
  "type": "object",
  "required": ["schema_version", "events", "tool_trace_hash"],
  "properties": {
    "schema_version": {"const": 1},
    "tool_trace_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "events": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sequence", "type", "content", "evidence_refs", "known_bad", "loss_mask", "target_weight"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 0},
          "type": {"enum": ["EVIDENCE", "PLAN", "ACTION", "OBSERVATION", "DIAGNOSIS", "VERIFY", "FINAL", "WRONG_HYPOTHESIS", "FAILURE_OUTPUT", "RECOVERY_ACTION", "TOOL_CALL", "TOOL_RESULT"]},
          "content": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "tool_name": {"type": ["string", "null"]},
          "tool_args": {},
          "tool_result_ref": {"type": ["string", "null"]},
          "known_bad": {"type": "boolean"},
          "loss_mask": {"type": "number", "minimum": 0},
          "target_weight": {"type": "number", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
