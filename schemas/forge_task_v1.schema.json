{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparsecoderlab.local/schemas/forge_task_v1.schema.json",
  "title": "ForgeBuilder repository repair task v1",
  "type": "object",
  "required": ["schema_version", "repository", "base_commit", "fixed_commit", "issue_id", "task_description", "environment_hash", "fail_to_pass", "pass_to_pass", "patch_sha256", "source_provenance"],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {"type": "string", "minLength": 1},
    "base_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "fixed_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "issue_id": {"type": "string", "minLength": 1},
    "task_description": {"type": "string", "minLength": 1},
    "environment_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fail_to_pass": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/testEvidence"}},
    "pass_to_pass": {"type": "array", "items": {"$ref": "#/$defs/testEvidence"}},
    "patch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_provenance": {"type": "object", "minProperties": 1}
  },
  "$defs": {
    "testEvidence": {
      "type": "object",
      "required": ["test_id", "before_status", "after_status", "test_hash"],
      "properties": {
        "test_id": {"type": "string", "minLength": 1},
        "before_status": {"enum": ["PASS", "FAIL"]},
        "after_status": {"enum": ["PASS", "FAIL"]},
        "test_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
