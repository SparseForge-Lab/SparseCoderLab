{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparsecoderlab.local/schemas/dataset_record_v1.schema.json",
  "title": "SparseCoderLab Dataset-v2 sample record v1",
  "type": "object",
  "required": ["schema_version", "source_id", "source_type", "content_sha256", "task_family", "real_or_generated", "data_stage", "license", "source_provenance"],
  "properties": {
    "schema_version": {"const": 1},
    "sample_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source_type": {"type": "string", "minLength": 1},
    "source_url": {"type": ["string", "null"]},
    "repo": {"type": ["string", "null"]},
    "commit_sha": {"type": ["string", "null"]},
    "timestamp": {"type": ["string", "null"]},
    "license": {"type": ["string", "null"]},
    "language": {"type": ["string", "null"]},
    "natural_language": {"type": ["array", "null"], "items": {"type": "string"}},
    "file_path": {"type": ["string", "null"]},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repo_id": {"type": ["string", "null"]},
    "near_dedup_cluster": {"type": ["string", "null"]},
    "token_count": {"type": ["integer", "null"], "minimum": 0},
    "quality_tier": {"type": ["string", "null"]},
    "task_family": {"type": "string", "minLength": 1},
    "difficulty": {"type": ["string", "number", "null"]},
    "real_or_generated": {"enum": ["real", "generated", "derived", "student_on_policy"]},
    "data_stage": {"enum": ["foundation", "posttraining", "student_recovery"]},
    "generator_model": {"type": ["string", "null"]},
    "generator_version": {"type": ["string", "null"]},
    "generator_prompt_version": {"type": ["string", "null"]},
    "critic_model": {"type": ["string", "null"]},
    "critic_version": {"type": ["string", "null"]},
    "execution_verified": {"type": ["boolean", "null"]},
    "compiler_verified": {"type": ["boolean", "null"]},
    "test_verified": {"type": ["boolean", "null"]},
    "test_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "environment_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "tool_trace_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "reasoning_type": {"type": ["string", "null"]},
    "stop_should_happen": {"type": ["boolean", "null"]},
    "hallucination_category": {"type": ["string", "null"]},
    "split": {"enum": ["train", "validation", "test", "quarantine", "unassigned"]},
    "eval_quarantine_status": {"type": ["string", "null"]},
    "source_provenance": {"type": ["object", "array", "string"]},
    "transformation_recipe": {"type": ["object", "string", "null"]},
    "parent_sample_ids": {"type": "array", "items": {"type": "string"}},
    "student_model": {"type": ["string", "null"]},
    "student_version": {"type": ["string", "null"]},
    "student_failure_type": {"type": ["string", "null"]},
    "recovery_source": {"type": ["string", "null"]},
    "recovery_verified": {"type": ["boolean", "null"]},
    "accepted": {"type": ["boolean", "null"]},
    "rejection_reason": {"type": ["string", "null"]},
    "created_at": {"type": ["string", "null"], "format": "date-time"},
    "modality": {"type": ["string", "null"]},
    "input_modalities": {"type": ["array", "null"], "items": {"type": "string"}},
    "output_modalities": {"type": ["array", "null"], "items": {"type": "string"}},
    "asset_references": {"type": ["array", "null"], "items": {"type": "object"}},
    "visual_verification": {"type": ["object", "null"]}
  },
  "additionalProperties": true
}
