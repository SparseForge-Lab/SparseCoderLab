{
  "schema_version": 1,
  "model": "Qwen3.8 Flash-Next GSQ-RCO IQ3_XXS",
  "model_scope": "full_flash_next",
  "production_generation_enabled": false,
  "profiles": {
    "32k": {"context_tokens": 32768, "reasoning_tokens_target": [150, 300]},
    "64k": {"context_tokens": 65536, "reasoning_tokens_target": [400, 800]},
    "128k": {"context_tokens": 131072, "reasoning_tokens_target": [400, 800]},
    "256k": {"context_tokens": 262144, "reasoning_tokens_target": [1000, 3000]}
  },
  "thinking_budgets": {
    "quick": {"reasoning_tokens_target": [150, 300], "use_for": ["tiny_tasks", "strongly_objectively_verified_outputs"]},
    "normal": {"reasoning_tokens_target": [400, 800], "use_for": ["normal_coding", "standard_reasoning", "small_repository_tasks"]},
    "deep": {"reasoning_tokens_target": [1000, 3000], "use_for": ["difficult_repository_tasks", "recovery", "ambiguous_bugs", "agentic_tasks", "multimodal_tasks"]}
  },
  "default_profile": "32k",
  "default_profile_note": "Authorized local runtime inherits the installed Strata IQ3_XXS config and shared settings, lowering context to 32768 only. Other profiles remain planning candidates. Reasoning-effort and sampling settings are inherited rather than replaced by these target budgets.",
  "cache_identity_fields": [
    "task", "context", "candidate", "patch", "objective_evidence",
    "critic_model", "critic_config", "critic_prompt_version"
  ],
  "acceptance_rule": "objective_verifier_pass_and_independent_critic_pass"
}
